# Copie este arquivo para .env e configure o PostgreSQL externo de serving.
# O banco roda em outro Compose no host; o scheduler mapeia localhost para o
# gateway Docker em docker-compose.override.yml.

POSTGRES_HOST=localhost
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# MinIO: para execução dentro do scheduler Astro, que participa da rede
# Docker externa raio-x-data. Use as credenciais de aplicação de produção
# geradas em /home/moscarde/raio-x-lake/.minio.application.env, nunca as root.
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_LANDING_BUCKET=raio-x-landing-prod
OBJECT_STORAGE_LAKE_BUCKET=raio-x-lake-prod
OBJECT_STORAGE_ARTIFACTS_BUCKET=raio-x-artifacts-prod
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Portal da Transparência (Governo Federal): registre um e-mail em
# https://api.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# para receber uma chave pessoal (chave-api-dados). Usada pelo collector de
# financiamento municipal completo (include/collectors/portaltransparencia).
PORTAL_TRANSPARENCIA_API_KEY=

# Copie este arquivo para .env e preencha com as credenciais reais.
# Banco de produção é um Postgres externo (nuvem), fora do stack do Astro.
# Nunca commitar host/usuário/senha reais aqui — só placeholders.

POSTGRES_HOST=changeme
POSTGRES_PORT=5432
POSTGRES_DB=raio_x_sus
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# Portal da Transparência (Governo Federal): registre um e-mail em
# https://api.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# para receber uma chave pessoal (chave-api-dados). Usada pelo collector de
# financiamento municipal completo (include/collectors/portaltransparencia).
PORTAL_TRANSPARENCIA_API_KEY=
